// SystemInit (no API) — The boot loader and first process of Kamix 3+.
//
// [API]
// SystemInit._powerOn (event): Fired once on green flag; starts the boot sequence.
//
// The API for managing SystemInit is SystemInitAPI.
sprite "SystemInit" {
    costumes: {
        icon: "../../assets/SystemInit.svg"
    };

    when greenFlag {
        looks.hide();
        signals.emitEvent("SystemInit._powerOn");
    }

    when signals.whenEventEmitted("SystemInit._powerOn") {
        xterm.initializeTerminal();
        xterm.showTerminal();
        xterm.logMessage("info", "SystemInit", "Terminal is ready!");

        // Smoke test for MemoryAPI. Won't exist in the real system.
        // fireAction only reports dispatch problems (e.g. no handler); errors raised
        // inside the handler are not visible here, so verify with a query instead.
        signals.fireAction("MemoryAPI.create", json.set("key", "hi", "{}"));
        signals.fireAction("MemoryAPI.write", json.set("value", "Hello, World!", json.set("key", "hi", "{}")));

        thread let result = signals.querySignal("MemoryAPI.read", json.set("key", "hi", "{}"));

        if (signals.didErrorOccur()) {
            xterm.logMessage("error", "SystemInit", operators.join(operators.join(signals.lastErrorType(), ": "), signals.lastErrorMessage()));
        } else {
            xterm.logMessage("success", "SystemInit", operators.join("MemoryAPI smoke test read back ", $result));
        }
    }
}
