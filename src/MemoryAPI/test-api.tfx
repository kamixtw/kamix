// Defines some test-only API calls for MemoryAPI, shouldn't be used in production as these
// aren't defended by semver

partial sprite "MemoryAPI" {
    // Internal function
    function create(key) {
        signals.fireAction("MemoryAPI.create", operators.join("{\"key\": \"", operators.join(key, "\"}")));
    }

    function write(key, value) {
        signals.fireAction("MemoryAPI.write", operators.join("{\"key\": \"", operators.join(key, operators.join("\", \"value\": \"", operators.join(value, "\"}")))));
    }

    returning function read(key) {
        return signals.fireAction("MemoryAPI.read", operators.join("{\"key\": \"", operators.join(key, "\"}")));
    }
}
