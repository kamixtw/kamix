// Test-only helpers for MemoryAPI. Not covered by semver.

partial sprite "MemoryAPI" {
    function create(key) {
        signals.fireAction("MemoryAPI.create", json.set("key", key, "{}"));
    }

    function write(key, value) {
        signals.fireAction("MemoryAPI.write", json.set("value", value, json.set("key", key, "{}")));
    }

    returning function read(key) {
        return signals.querySignal("MemoryAPI.read", json.set("key", key, "{}"));
    }
}
