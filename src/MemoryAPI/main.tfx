// MemoryAPI (MemoryAPI) — A speedy volatile key-value registry.
//
// [API]
// MemoryAPI.create (action): { key }
// MemoryAPI.write (action): { key, value }
// MemoryAPI.read (query): { key }
//
// Memory is a single JSON object ({ "key": "value" }). Errors are raised as
// `MemoryAPIError`. Actions are fire-and-forget: a failure is only visible
// through signals.didErrorOccur() from inside the handler, not to the caller.

sprite "MemoryAPI" {
    costumes: {
        icon: "../../assets/MemoryAPI.svg"
    };

    let memory = "{}";
    list locks = [];

    when greenFlag {
        looks.hide();
        memory = "{}";
        locks.clear();
        xterm.logMessage("debug", "MemoryAPI", "Registering error type `MemoryAPIError`.");
        signals.registerErrorType("MemoryAPIError");
        xterm.logMessage("info", "MemoryAPI", "MemoryAPI is ready.");
    }

    // [ENDPOINT] MemoryAPI.create: { key }
    // Creates a new key holding the placeholder value `_empty`.
    //
    // [ARGS]
    // key (string): The key to create. Must not already exist.
    when signals.whenActionReceived("MemoryAPI.create") {
        thread let req = signals.getSignalData();

        xterm.logMessage("trace", "MemoryAPI", operators.join("create: received request ", $req));

        if (not json.hasKey("key", $req)) {
            xterm.logMessage("error", "MemoryAPI", operators.join("create: rejected malformed request ", $req));
            signals.raiseError("MemoryAPIError", "Malformed request: You need `key`!");
        }

        thread let key = json.get("key", $req);

        if (locks.contains($key)) {
            xterm.logMessage("debug", "MemoryAPI", operators.join("create: waiting for lock on key ", $key));
            control.waitUntil(not locks.contains($key));
        }

        // Checked after the lock wait so we never act on stale state.
        if (json.hasKey($key, memory)) {
            xterm.logMessage("error", "MemoryAPI", operators.join("create: key already exists: ", $key));
            signals.raiseError("MemoryAPIError", operators.join(operators.join("Item with key `", $key), "` already exists!"));
        }

        locks.push($key);
        memory = json.set($key, "_empty", memory);
        locks.deleteAt(locks.itemNumber($key));

        xterm.logMessage("trace", "MemoryAPI", operators.join("create: created key ", $key));
    }

    // [ENDPOINT] MemoryAPI.write: { key, value }
    // Overwrites the value of an existing key.
    //
    // [ARGS]
    // key (string): The key to write to. Must already exist.
    // value (string): The new value.
    when signals.whenActionReceived("MemoryAPI.write") {
        thread let req = signals.getSignalData();

        xterm.logMessage("trace", "MemoryAPI", operators.join("write: received request ", $req));

        if (not json.hasKey("key", $req)) {
            xterm.logMessage("error", "MemoryAPI", operators.join("write: rejected malformed request ", $req));
            signals.raiseError("MemoryAPIError", "Malformed request: You need `key`!");
        }

        if (not json.hasKey("value", $req)) {
            xterm.logMessage("error", "MemoryAPI", operators.join("write: rejected malformed request ", $req));
            signals.raiseError("MemoryAPIError", "Malformed request: You need `value`!");
        }

        thread let key = json.get("key", $req);

        if (locks.contains($key)) {
            xterm.logMessage("debug", "MemoryAPI", operators.join("write: waiting for lock on key ", $key));
            control.waitUntil(not locks.contains($key));
        }

        if (not json.hasKey($key, memory)) {
            xterm.logMessage("error", "MemoryAPI", operators.join("write: key does not exist: ", $key));
            signals.raiseError("MemoryAPIError", operators.join(operators.join("Item with key `", $key), "` does not exist!"));
        }

        locks.push($key);
        memory = json.set($key, json.get("value", $req), memory);
        locks.deleteAt(locks.itemNumber($key));

        xterm.logMessage("trace", "MemoryAPI", operators.join("write: wrote key ", $key));
    }

    // [ENDPOINT] MemoryAPI.read: { key }
    // Returns `{ "<key>": "<value>" }` for an existing key.
    //
    // [ARGS]
    // key (string): The key to read. Must already exist.
    when signals.whenQueryRequested("MemoryAPI.read") {
        thread let req = signals.getSignalData();

        xterm.logMessage("trace", "MemoryAPI", operators.join("read: received request ", $req));

        if (not json.hasKey("key", $req)) {
            xterm.logMessage("error", "MemoryAPI", operators.join("read: rejected malformed request ", $req));
            signals.raiseError("MemoryAPIError", "Malformed request: You need `key`!");
        }

        thread let key = json.get("key", $req);

        if (locks.contains($key)) {
            xterm.logMessage("debug", "MemoryAPI", operators.join("read: waiting for lock on key ", $key));
            control.waitUntil(not locks.contains($key));
        }

        if (not json.hasKey($key, memory)) {
            xterm.logMessage("error", "MemoryAPI", operators.join("read: key does not exist: ", $key));
            signals.raiseError("MemoryAPIError", operators.join(operators.join("Item with key `", $key), "` does not exist!"));
        }

        xterm.logMessage("trace", "MemoryAPI", operators.join("read: read key ", $key));

        signals.returnValue(json.set($key, json.get($key, memory), "{}"));
    }
}
